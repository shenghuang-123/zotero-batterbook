{
  "name": "zetara",
  "type": "module",
  "version": "1.1.0",
  "description": "A vertical PDF-cover bookshelf for Zotero with native reading and multiple attachments.",
  "config": {
    "addonName": "Zetara",
    "addonID": "zetara@zotero-plugin.local",
    "addonRef": "zetara",
    "addonInstance": "Zetara",
    "prefsPrefix": "extensions.zotero.zetara"
  },
  "author": "Zetara contributors; based on Cover View by Paul Luis Röhl",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/paulluis-roehl/zotero-cover-view.git"
  },
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.2.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.2",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "chai": "^6.2.2",
    "eslint": "^10.11.0",
    "mocha": "^12.0.2",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.9.2",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
